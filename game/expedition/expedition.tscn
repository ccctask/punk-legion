ambient_light_source = 2
ambient_light_color = Color(0.88,0.88,0.79,1)
ambient_light_energy = 0.7

[sub_resource type="Shader" id="FloorShader"]
code = "shader_type spatial;
varying vec3 wp;
void vertex(){wp=(MODEL_MATRIX*vec4(VERTEX,1)).xyz;}
void fragment(){ vec2 g=abs(fract(wp.xz/4.0+0.5)-0.5);float line=1.0-smoothstep(0.006,0.018,min(g.x,g.y));float gravel=sin(wp.x*0.23+cos(wp.z*0.4))*0.016;ALBEDO=mix(vec3(0.18,0.265,0.22)+gravel,vec3(0.23,0.30,0.24),line);ROUGHNESS=1.0;}"
